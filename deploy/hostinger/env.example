# Server .env for the AlphaGrew demo on Hostinger. Copy to the site folder as ".env" (next to
# artisan), fill in the <...> values, then run: php artisan key:generate
# Never commit this file or paste its values into chat.

APP_NAME=AlphaGrew
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://alphagrew.chromologtechnologies.com
FRONTEND_URL=https://alphagrew.chromologtechnologies.com
CORS_ALLOWED_ORIGINS=https://alphagrew.chromologtechnologies.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

# hPanel > Databases > MySQL Databases (names start with your u123456789_ prefix)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<database name>
DB_USERNAME=<database user>
DB_PASSWORD=<database password>

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
# No long-running worker on shared hosting: the every-minute cron job processes queued jobs.
QUEUE_RUN_FROM_SCHEDULER=true
FILESYSTEM_DISK=local

# Demo accounts (admin@demo.com, student@demo.com, owner@demo.com ...). Choose a private
# password: the repository is public, so the default "demo123" is known to anyone.
DEMO_SEED_ENABLED=true
DEMO_PASSWORD=<private demo password>
DEMO_RESET_ENABLED=false

# hPanel > Emails > info@chromologtechnologies.com (Hostinger SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@chromologtechnologies.com
MAIL_PASSWORD=<mailbox password>
MAIL_FROM_ADDRESS=info@chromologtechnologies.com
MAIL_FROM_NAME=AlphaGrew
DEMO_REQUESTS_EMAIL=info@chromologtechnologies.com

# AI features (resume analysis, mock interviews). Leave empty to try the rest of the demo.
ANTHROPIC_API_KEY=
