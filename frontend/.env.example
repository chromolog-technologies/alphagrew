# Never put AI provider keys or other secrets here: every VITE_ variable is bundled into the
# browser build. AI keys belong in the Laravel backend's .env.

# React frontend to Laravel API connection.
# Use /api/v1 when developing with the Vite proxy below and a local Laravel server.
VITE_API_BASE_URL="/api/v1"

# Builds fail when VITE_API_BASE_URL is empty, unless this is "true" (offline demo on
# sample data). It also shows the demo-account picker on the login page; the dev server
# always shows it.
VITE_DEMO_MODE="false"

# Local-only Vite proxy target for the Laravel backend.
LARAVEL_DEV_URL="http://127.0.0.1:8000"

# Public marketing site (optional).
# VITE_CONTACT_EMAIL: optional. Overrides the email shown on the site (default info@chromologtechnologies.com).
# Demo requests are sent to the API (POST /demo-requests); the inbox that receives them is DEMO_REQUESTS_EMAIL in backend/.env.
VITE_CONTACT_EMAIL=""
# VITE_SITE_URL: the public website's address (default https://alphagrew.com). Used for canonical
# URLs, link-preview images, sitemap.xml and the pre-rendered pages.
VITE_SITE_URL="https://alphagrew.com"

# VITE_ANALYTICS: "off" leaves out Vercel Web Analytics; set it when hosting anywhere but Vercel.
VITE_ANALYTICS=""
