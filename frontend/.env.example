# GEMINI_API_KEY: Server-side only (read by the legacy server.ts prototype at runtime).
# It is never bundled into the browser build. AI provider keys belong in the Laravel
# backend's .env, and must never be given a VITE_ prefix, which would expose them to clients.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# React frontend to Laravel API connection.
# Use /api/v1 when developing with the Vite proxy below and a local Laravel server.
VITE_API_BASE_URL="/api/v1"

# Local-only Vite proxy target for the Laravel backend.
LARAVEL_DEV_URL="http://127.0.0.1:8000"
