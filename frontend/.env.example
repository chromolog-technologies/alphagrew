# Never put AI provider keys or other secrets here: every VITE_ variable is bundled into the
# browser build. AI keys belong in the Laravel backend's .env.

# React frontend to Laravel API connection.
# Use /api/v1 when developing with the Vite proxy below and a local Laravel server.
VITE_API_BASE_URL="/api/v1"

# Builds fail when VITE_API_BASE_URL is empty, unless this is "true" (offline demo on
# sample data). It also shows the demo-account picker on the login page; the dev server
# always shows it.
VITE_DEMO_MODE="false"

# Local-only Vite proxy target for the Laravel backend.
LARAVEL_DEV_URL="http://127.0.0.1:8000"

# Public marketing site (optional).
# VITE_CONTACT_EMAIL: inbox for demo requests. The Book a demo form opens a pre-filled email
# to this address; without it the contact page says requests are not open yet.
VITE_CONTACT_EMAIL=""
# VITE_SITE_URL: public origin, e.g. https://www.example.com. Enables canonical URLs and the
# generated sitemap.xml; leave empty until the domain is decided.
VITE_SITE_URL=""
