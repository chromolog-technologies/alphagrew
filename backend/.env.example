APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Debug pages show stack traces and config values. Set to true only on your own machine.
APP_DEBUG=false
APP_URL=http://localhost
# The React app; email links (password reset, invitations) open it.
FRONTEND_URL=http://localhost:5173

# Allows POST /api/v1/campus/reset to wipe and re-seed demo data.
# When unset it is on only for APP_ENV=local or testing. Never enable in production.
# DEMO_RESET_ENABLED=false

# API tokens expire after this many minutes (default 720 = 12 hours).
SANCTUM_EXPIRATION=720

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alphagrew
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Interview Journey (config/ai.php). Without a key every stage uses its deterministic engine.
ANTHROPIC_API_KEY=
AI_CHAIN=anthropic:claude-opus-5-5
ANTHROPIC_SERVER_FALLBACKS=true
AI_TIMEOUT=30
# Optional poppler pdftotext binary for better PDF text extraction.
PDFTOTEXT_PATH=
# OpenAI-compatible /audio/transcriptions endpoint for voice answers (e.g. Whisper).
AI_TRANSCRIPTION_URL=
AI_TRANSCRIPTION_KEY=
AI_TRANSCRIPTION_MODEL=whisper-1
